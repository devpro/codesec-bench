root = true

[*]
end_of_line = lf
insert_final_newline = true

[*.{php,html,twig}]
charset = utf-8
indent_size = 4
indent_style = space
trim_trailing_whitespace = true

[*.{yaml}]
charset = utf-8
indent_size = 2
indent_style = space
trim_trailing_whitespace = true

[*.md]
charset = utf-8
indent_size = 2
indent_style = space
max_line_length = 160
trim_trailing_whitespace = false

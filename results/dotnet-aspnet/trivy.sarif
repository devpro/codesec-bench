{
  "version": "2.1.0",
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "fullName": "Trivy Vulnerability Scanner",
          "informationUri": "https://github.com/aquasecurity/trivy",
          "name": "Trivy",
          "rules": [
            {
              "id": "CVE-2024-21907",
              "name": "LanguageSpecificPackageVulnerability",
              "shortDescription": {
                "text": "Improper Handling of Exceptional Conditions in Newtonsoft.Json"
              },
              "fullDescription": {
                "text": "Newtonsoft.Json before version 13.0.1 is affected by a mishandling of exceptional conditions vulnerability. Crafted data that is passed to the JsonConvert.DeserializeObject method may trigger a StackOverflow exception resulting in denial of service. Depending on the usage of the library, an unauthenticated and remote attacker may be able to cause the denial of service condition."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2024-21907",
              "help": {
                "text": "Vulnerability CVE-2024-21907\nSeverity: HIGH\nPackage: Newtonsoft.Json\nFixed Version: 13.0.1\nLink: [CVE-2024-21907](https://avd.aquasec.com/nvd/cve-2024-21907)\nNewtonsoft.Json before version 13.0.1 is affected by a mishandling of exceptional conditions vulnerability. Crafted data that is passed to the JsonConvert.DeserializeObject method may trigger a StackOverflow exception resulting in denial of service. Depending on the usage of the library, an unauthenticated and remote attacker may be able to cause the denial of service condition.",
                "markdown": "**Vulnerability CVE-2024-21907**\n| Severity | Package | Fixed Version | Link |\n| --- | --- | --- | --- |\n|HIGH|Newtonsoft.Json|13.0.1|[CVE-2024-21907](https://avd.aquasec.com/nvd/cve-2024-21907)|\n\nNewtonsoft.Json before version 13.0.1 is affected by a mishandling of exceptional conditions vulnerability. Crafted data that is passed to the JsonConvert.DeserializeObject method may trigger a StackOverflow exception resulting in denial of service. Depending on the usage of the library, an unauthenticated and remote attacker may be able to cause the denial of service condition."
              },
              "properties": {
                "cvssv3_baseScore": 7.5,
                "cvssv3_vector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H",
                "precision": "very-high",
                "security-severity": "7.5",
                "tags": [
                  "vulnerability",
                  "security",
                  "HIGH"
                ]
              }
            }
          ],
          "version": "0.73.0"
        }
      },
      "results": [
        {
          "ruleId": "CVE-2024-21907",
          "level": "error",
          "message": {
            "text": "Package: Newtonsoft.Json\nInstalled Version: 12.0.1\nVulnerability CVE-2024-21907\nSeverity: HIGH\nFixed Version: 13.0.1\nLink: [CVE-2024-21907](https://avd.aquasec.com/nvd/cve-2024-21907)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "packages.lock.json",
                  "uriBaseId": "ROOTPATH"
                },
                "region": {
                  "startLine": 21,
                  "startColumn": 1,
                  "endLine": 26,
                  "endColumn": 1
                }
              },
              "message": {
                "text": "packages.lock.json: Newtonsoft.Json@12.0.1"
              }
            }
          ]
        }
      ],
      "columnKind": "utf16CodeUnits",
      "originalUriBaseIds": {

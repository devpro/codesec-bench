              "id": "CVE-2026-41854",
              "name": "LanguageSpecificPackageVulnerability",
              "shortDescription": {
                "text": "spring-framework: Spring Framework: Server-Side Request Forgery via incorrect host parsing"
              },
              "fullDescription": {
                "text": "Due to incorrect host parsing, applications that rely on UriComponentsBuilder to parse and validate an externally provided URL string may be exposed to a server-side request forgery (SSRF) attack.\n\nAffected versions:\nSpring Framework 7.0.0 through 7.0.7; 6.2.0 through 6.2.18."
              },
              "defaultConfiguration": {
                "level": "warning"

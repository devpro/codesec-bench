                  "snippet": {
                    "text": "            $this->logger->error(\n                sprintf('API response error on %s: %s', $endpoint, $e->getMessage())\n            );"
                  },
                  "startColumn": 13,
                  "startLine": 56
                }
              }
            }
          ],
          "message": {
            "text": "Potential sensitive data exposure (CWE-532): exception messages passed directly to a logger may contain secrets, tokens, API keys, internal hostnames, or stack details that should not appear in log files. Sanitize or redact the exception message before logging, or log only a safe error code/type without the raw message.\n"
          },
          "properties": {},
          "ruleId": "semgrep.sensitive-exception-message-in-log"
